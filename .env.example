# Copy to .env and fill in. .env is gitignored — never commit real values.
#   set -a && source .env && set +a && mix phx.server
#
# Choose ONE mode. Setting both makes the app refuse to boot.

# --- Mode 1: direct OpenCode Go key -----------------------------------------
# Without it (and without gateway mode) the app still boots and the static demo
# works, but chat requests fail. Must be an OpenCode Go key (/zen/go/v1).
OPENCODE_API_KEY=

# --- Mode 2: SuperDev AI Gateway (no provider key in the app) ---------------
# A Cloudflare Access service token for this service + environment.
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
# AI_GATEWAY_DOMAIN=gateway.superdev.mx
# AI_GATEWAY_KEY_ALIAS=production

# --- Optional, both modes ----------------------------------------------------
# Default base URL: https://opencode.ai/zen/go/v1 (direct) or
# https://<AI_GATEWAY_DOMAIN>/opencode/v1 (gateway; must stay on that domain).
# OPENCODE_BASE_URL=
# Default model, served through the Responses API.
# OPENCODE_MODEL=gpt-5.6-luna

# When set, the LiveView chat panel is gated behind this password.
# Leave unset locally to have chat unlocked on load.
# DEMO_PASSWORD=

# Spanish demo: USD to MXN rate (MXN per 1 USD), its date, and its source.
# Without a valid rate, the Spanish page shows USD.
# FX_USD_MXN=17.8413
# FX_USD_MXN_DATE=2026-09-28
# FX_USD_MXN_SOURCE=FIX de Banxico

# Phoenix HTTP port.
# PORT=4000
