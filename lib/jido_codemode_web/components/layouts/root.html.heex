<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Agentic BI" suffix=" · Decision-ready analysis">
      {assigns[:page_title]}
    </.live_title>

    <meta
      name="description"
      content="Turn business questions into clear, decision-ready analysis with Agentic BI."
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Agentic BI" />
    <meta
      property="og:description"
      content="Turn business questions into clear, decision-ready analysis."
    />
    <meta property="og:image" content={url(~p"/images/agentic-bi-og.png")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Agentic BI — data signals converging into action." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Agentic BI" />
    <meta
      name="twitter:description"
      content="Turn business questions into clear, decision-ready analysis."
    />
    <meta name="twitter:image" content={url(~p"/images/agentic-bi-og.png")} />
    <link rel="icon" href={~p"/images/agentic-bi-mark.svg"} type="image/svg+xml" />
    <link rel="icon" href={~p"/favicon.ico"} sizes="64x64" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
  </head>
  <body class="bg-base-100 font-sans text-base-content antialiased">
    {@inner_content}
  </body>
</html>
